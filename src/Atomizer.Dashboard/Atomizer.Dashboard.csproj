<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1901,NU1902,NU1903,NU1904</WarningsNotAsErrors>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <AnalysisLevel>latest</AnalysisLevel>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>Atomizer.Dashboard</PackageId>
        <Description>Atomizer.Dashboard provides an embedded Blazor Server dashboard for monitoring and managing Atomizer queues, jobs, and recurring schedules.</Description>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Atomizer\Atomizer.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Auto-imported by NuGet consumers. Sets UsingMicrosoftNETSdkRazor=true so that
             _framework/blazor.server.js is included in the host's static web assets manifest.
             Project-reference consumers get this automatically by referencing a Razor SDK project. -->
        <None Include="build\Atomizer.Dashboard.props" Pack="true" PackagePath="build/" />
    </ItemGroup>
</Project>
